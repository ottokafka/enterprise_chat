# RAG DOCUMENT INGESTION
# Ingest a .docx file — uses employee_handbook.docx already in project root
POST http://localhost:4445/v1/ingest HTTP/1.1
Authorization: Bearer loser_use_typescript12345
Content-Type: multipart/form-data; boundary=----FormBoundary7MA4YWxkTrZu0gW

------FormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="employee_handbook.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./employee_handbook.docx
------FormBoundary7MA4YWxkTrZu0gW--

###

# RAG INGESTION — verify what was stored in ClickHouse after ingestion
# Run this query directly against your ClickHouse instance:
#
# SELECT chunk_type, count() as total
# FROM default.rag_embeddings
# WHERE document_name = 'employee_handbook.docx'
# GROUP BY chunk_type;
#
# RAG SEARCH — semantic search (replace embedding array with real values)
# SELECT document_name, chunk_type, content,
#        cosineDistance(embedding, [/* query embedding array */]) AS distance
# FROM default.rag_embeddings
# ORDER BY distance ASC
# LIMIT 5;

# RAG CONTEXT RETRIEVAL — Phase 2
# Hybrid Search (Dense + Sparse) → RRF → Cross-Encoder Re-rank
POST http://localhost:4445/v1/retrieve HTTP/1.1
Authorization: Bearer loser_use_typescript12345
Content-Type: application/json

{
  "query": "What is the employee leave policy?",
  "document_name": "employee_handbook.docx",
  "top_n": 5
}

###

# RAG RETRIEVAL — no document filter (searches entire knowledge base)
POST http://localhost:4445/v1/retrieve HTTP/1.1
Authorization: Bearer loser_use_typescript12345
Content-Type: application/json

{
  "query": "What caused the revenue growth in Q3?",
  "top_n": 5
}

# RAG FULL PIPELINE — Phase 3 (Retrieve → Augment → Generate → Citations)
POST http://localhost:4445/v1/rag HTTP/1.1
Authorization: Bearer loser_use_typescript12345
Content-Type: application/json

{
  "query": "What is the employee leave policy?",
  "document_name": "employee_handbook.docx",
  "top_n": 5,
  "max_tokens": 512
}

###

# RAG FULL PIPELINE — streaming response
POST http://localhost:4445/v1/rag HTTP/1.1
Authorization: Bearer loser_use_typescript12345
Content-Type: application/json

{
  "query": "Summarize the key benefits offered to employees.",
  "document_name": "employee_handbook.docx",
  "top_n": 5,
  "stream": true,
  "max_tokens": 512
}

